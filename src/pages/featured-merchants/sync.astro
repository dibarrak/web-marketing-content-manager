---
import AppLayout from '@layouts/AppLayout.astro';
import FeaturedMerchantsSync from '@components/dashboard/FeaturedMerchantsSync';
import { FEATURED_MERCHANTS_SYNC } from '@lib/config/sites';
import { withBase } from '@lib/base-path';
import { isAdmin } from '@lib/authz';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(withBase('login'));
if (!isAdmin(user)) return Astro.redirect(withBase('dashboard'));
---

<AppLayout title={`Sincronización — ${FEATURED_MERCHANTS_SYNC.displayName}`}>
  <FeaturedMerchantsSync client:only="react" siteId={FEATURED_MERCHANTS_SYNC.siteId} />
</AppLayout>
