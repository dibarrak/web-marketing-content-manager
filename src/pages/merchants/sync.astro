---
import AppLayout from '@layouts/AppLayout.astro';
import MerchantSync from '@components/dashboard/MerchantSync';
import { MERCHANT_SYNC } from '@lib/config/sites';
import { withBase } from '@lib/base-path';
import { isAdmin } from '@lib/authz';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(withBase('login'));
if (!isAdmin(user)) return Astro.redirect(withBase('dashboard'));
---

<AppLayout title={`Sincronización — ${MERCHANT_SYNC.displayName}`}>
  <MerchantSync client:only="react" siteId={MERCHANT_SYNC.siteId} />
</AppLayout>
