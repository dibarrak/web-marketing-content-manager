---
import AppLayout from '@layouts/AppLayout.astro';
import LongtailSlidersSync from '@components/dashboard/LongtailSlidersSync';
import { LONGTAIL_SLIDERS_SYNC } from '@lib/config/sites';
import { withBase } from '@lib/base-path';
import { isAdmin } from '@lib/authz';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(withBase('login'));
if (!isAdmin(user)) return Astro.redirect(withBase('dashboard'));
---

<AppLayout title={`Sincronización — ${LONGTAIL_SLIDERS_SYNC.displayName}`}>
  <LongtailSlidersSync client:only="react" siteId={LONGTAIL_SLIDERS_SYNC.siteId} />
</AppLayout>
