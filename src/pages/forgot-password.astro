---
import '@styles/globals.scss';
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@lib/base-path';

export const prerender = false;
---

<BaseLayout title="Recuperar acceso — Webflow Content Manager">
  <main class="card">
    <h1>Recuperar acceso</h1>
    <p>
      Por el momento el restablecimiento de contraseñas se gestiona manualmente.
      Si olvidaste tu contraseña, escribe a
      <a href="mailto:david.ibarra@kueski.com">david.ibarra@kueski.com</a>
      para que un administrador restablezca tu acceso.
    </p>
    <p class="muted">
      Recibirás una contraseña temporal o un enlace para definir una nueva.
    </p>
    <a class="back" href={withBase('login')}>← Volver a iniciar sesión</a>
  </main>
</BaseLayout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .card {
    display: flex;
    flex-direction: column;
    gap: $space-4;
    max-width: 420px;
    margin: 80px auto;
    padding: $space-6;
    @include card;

    h1 {
      margin: 0;
      font-size: 24px;
    }
    p {
      margin: 0;
      line-height: 1.6;
      font-size: 15px;
    }
    .muted {
      color: $color-text-muted;
      font-size: 14px;
    }
    a {
      color: $color-primary;
    }
    .back {
      font-size: 14px;
      text-decoration: none;
      &:hover {
        text-decoration: underline;
      }
    }
  }
</style>
