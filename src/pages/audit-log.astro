---
import AppLayout from '@layouts/AppLayout.astro';
import AuditLogView from '@components/dashboard/AuditLogView';
import { withBase } from '@lib/base-path';
import { canAccessSection } from '@lib/authz';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(withBase('login'));
if (!canAccessSection(user, 'auditLog')) return Astro.redirect(withBase('dashboard'));
---

<AppLayout title="Bitácora — Webflow Content Manager">
  <AuditLogView client:only="react" />
</AppLayout>
